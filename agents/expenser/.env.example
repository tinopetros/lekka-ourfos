# cp to .env for `make agent`. On Cloud Run, Terraform sets these
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=ourfos-dev
# Where the model is served. The container itself runs in africa-south1
GOOGLE_CLOUD_LOCATION=global
EXPENSER_MODEL=gemini-3.5-flash-lite
# Model Armor has no africa-south1 or global endpoint
MODEL_ARMOR_TEMPLATE=projects/ourfos-dev/locations/eu/templates/expenser
# gs:// refs are read from here. Drive ids only work on Cloud Run: only ourfos-services can act as lekkai@
ATTACHMENTS_BUCKET=ourfos-dev-attachments
